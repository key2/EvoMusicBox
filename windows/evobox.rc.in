// evobox.rc.in -> generated/windows/evobox.rc (cmake configure_file): version info + manifest
#include <windows.h>

1 24 "@EVOBOX_RC_MANIFEST@"

// application icon: Explorer / taskbar use the first icon group, GLFW picks the resource named
// GLFW_ICON for the window icon
@EVOBOX_RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @EVOBOX_VERSION_RC@
 PRODUCTVERSION @EVOBOX_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EvoMusicBox"
            VALUE "FileDescription", "EvoMusicBox - live soundboard with OSC triggers"
            VALUE "FileVersion", "@EVOBOX_VERSION@"
            VALUE "InternalName", "evobox"
            VALUE "LegalCopyright", "EvoMusicBox contributors. Bundles FFmpeg (LGPL v2.1+), see LICENSES.txt"
            VALUE "OriginalFilename", "evobox.exe"
            VALUE "ProductName", "EvoMusicBox"
            VALUE "ProductVersion", "@EVOBOX_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
